{
  "name": "yapu",
  "type": "module",
  "version": "1.0.0",
  "description": "YAPU — Plataforma PWA Web y Móvil para el aprendizaje de Quechua con IA Determinista",
  "scripts": {
    "dev": "astro dev --port 9500 --host",
    "start": "astro dev --port 9500 --host",
    "build": "astro build",
    "preview": "astro preview --port 9500 --host",
    "astro": "astro",
    "lint": "eslint src/ tests/ && tsc --noEmit",
    "test": "vitest run tests/unit tests/regression",
    "test:unit": "vitest run tests/unit",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.4.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
