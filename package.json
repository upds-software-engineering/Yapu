{
  "name": "yapu",
  "type": "module",
  "version": "1.0.0",
  "description": "YAPU — Plataforma PWA Web y Móvil para el aprendizaje de Quechua con IA Determinista",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "astro dev --port 9500 --host",
    "start": "astro dev --port 9500 --host",
    "build": "astro build && node scripts/generar-service-worker.mjs",
    "preview": "astro preview --port 9500 --host",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit && astro check",
    "lint:capas": "node scripts/verificar-capas.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:component": "vitest run tests/component",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e/flujos",
    "test:e2e:ux": "playwright test tests/e2e/ux",
    "test:a11y": "playwright test tests/e2e/a11y",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e && npm run test:a11y && npm run test:e2e:ux",
    "verificar:paginas": "node scripts/verificar-paginas.mjs",
    "reports:trazabilidad": "node scripts/generar-matriz-trazabilidad.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^5.4.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
