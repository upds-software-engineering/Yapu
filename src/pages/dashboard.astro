---
import Layout from '../layouts/Layout.astro';
import { BannerConexion, Navegacion } from '@ui/components/layout';
import { Tablero } from '@ui/components/tablero';
---

<Layout
  titulo="Mi progreso — YAPU"
  descripcion="Estadísticas de avance, experiencia, racha y palabras aprendidas del estudiante."
  rutaActual="/dashboard"
>
  <BannerConexion client:load />
  <Navegacion client:load rutaActual="/dashboard" />

  <!-- El `<h1>` de la pantalla (el nombre del estudiante) lo aporta `Tablero`. -->
  <Tablero client:load />
</Layout>
