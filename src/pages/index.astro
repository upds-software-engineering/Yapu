---
import Layout from '../layouts/Layout.astro';
import { BannerConexion, Navegacion } from '@ui/components/layout';
import { Portada } from '@ui/components/portada';
import { MapaNiveles } from '@ui/components/niveles';
---

<Layout
  titulo="YAPU — Aprende quechua con IA determinista y sin conexión"
  descripcion="Curso A1 de quechua con evaluaciones de IA determinista, tarjetas interactivas y funcionamiento sin conexión a internet."
  rutaActual="/"
>
  <!-- Aviso de conexión (RF-009) y navegación principal: las monta la página, no el Layout. -->
  <BannerConexion client:load />
  <Navegacion client:load rutaActual="/" />

  <!--
    Hick: la portada es informativa y no añade ninguna acción; el único CTA primario de la pantalla
    lo pone `MapaNiveles` en el nivel actual. El `<h1>` accesible lo aporta la propia portada.
  -->
  <Portada client:load />
  <MapaNiveles client:load />
</Layout>
