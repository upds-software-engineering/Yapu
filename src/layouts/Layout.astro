---
import '../styles/global.css';
// Fuentes auto-hospedadas (ADR-004): sin conexiones previas ni descargas a CDNs externos,
// para que la PWA funcione sin conexión y no dependa de terceros.
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import { ruta } from '../ui/lib/ruta';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Ruta lógica actual; las páginas pueden pasarla para que la navegación resalte el destino. */
  rutaActual?: string;
}

const {
  titulo = 'YAPU — Plataforma de Aprendizaje de Quechua',
  descripcion = 'Aprende quechua desde cero con evaluaciones de IA determinista, tarjetas interactivas y funcionamiento offline.',
  rutaActual = Astro.url.pathname
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <!--
      WCAG 1.4.4 (Redimensionar texto): el zoom NO se limita ni se desactiva; sólo se pide el
      ancho del dispositivo, la escala inicial 1 y cubrir el área segura del notch.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')} />
    <link rel="manifest" href={ruta('/manifest.json')} />
    <meta name="theme-color" content="#B94700" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="YAPU" />
    <meta name="application-name" content="YAPU" />
    <meta name="description" content={descripcion} />

    <title>{titulo}</title>
  </head>
  <body
    class="min-h-screen bg-andina-night font-sans text-slate-100 antialiased selection:bg-andina-gold selection:text-black"
    data-ruta-actual={rutaActual}
  >
    <!-- El aviso de modo sin conexión lo aporta <BannerConexion /> de src/ui/components/layout
         (RF-009/RN-15); aquí sólo queda el registro del Service Worker. -->
    <main id="contenido" class="pb-[calc(6rem_+_env(safe-area-inset-bottom))] md:pb-0">
      <slot />
    </main>

    <!--
      Registro del Service Worker (RF-009).
      Script de módulo procesado por Astro/Vite (no `is:inline`): así `import.meta.env.BASE_URL`
      se sustituye en el build y la ruta del SW respeta el despliegue bajo `/Yapu/`.
    -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // `import.meta.env.BASE_URL` puede venir con o sin barra final según el build, así que se
          // normaliza aquí: registrar `/Yapusw.js` (sin barra) daría un 404 silencioso y dejaría la
          // aplicación sin modo offline.
          const base = import.meta.env.BASE_URL;
          const prefijo = base.endsWith('/') ? base : `${base}/`;
          navigator.serviceWorker.register(`${prefijo}sw.js`).catch(() => {
            // Sin Service Worker la aplicación sigue siendo usable; el modo offline se degrada.
          });
        });
      }
    </script>
  </body>
</html>
