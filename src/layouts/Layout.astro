---
import '../styles/global.css';
// Fuentes auto-hospedadas (ADR-004): sin conexiones previas ni descargas a CDNs externos,
// para que la PWA funcione sin conexión y no dependa de terceros.
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import { ruta } from '../ui/lib/ruta';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Ruta lógica actual; las páginas pueden pasarla para que la navegación resalte el destino. */
  rutaActual?: string;
}

const {
  titulo = 'YAPU — Plataforma de Aprendizaje de Quechua',
  descripcion = 'Aprende quechua desde cero con evaluaciones de IA determinista, tarjetas interactivas y funcionamiento offline.',
  rutaActual = Astro.url.pathname
} = Astro.props;

/** El Service Worker sólo existe en el build; en desarrollo se limpia (ver el final del `<body>`). */
const esDesarrollo = import.meta.env.DEV;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!--
      WCAG 1.4.4 (Redimensionar texto): el zoom NO se limita ni se desactiva; sólo se pide el
      ancho del dispositivo, la escala inicial 1 y cubrir el área segura del notch.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')} />
    <link rel="manifest" href={ruta('/manifest.json')} />
    <meta name="theme-color" content="#B94700" />
    <!-- Tema único oscuro: el navegador pinta sus controles nativos en oscuro desde el primer byte. -->
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="YAPU" />
    <meta name="application-name" content="YAPU" />
    <meta name="description" content={descripcion} />

    <title>{titulo}</title>
  </head>
  <body
    class="min-h-screen bg-fondo font-sans text-tinta antialiased selection:bg-acento selection:text-fondo"
    data-ruta-actual={rutaActual}
  >
    <!-- El aviso de modo sin conexión lo aporta <BannerConexion /> de src/ui/components/layout
         (RF-009/RN-15); aquí sólo queda el registro del Service Worker. -->
    <main id="contenido" class="pb-[calc(6rem_+_env(safe-area-inset-bottom))] md:pb-0">
      <slot />
    </main>

    <!--
      Desarrollo: NO hay Service Worker. `npm run preview` y los E2E usan el MISMO origen
      (localhost:9500), así que el SW del build queda registrado y, con su estrategia cache-first,
      sirve copias viejas de `@vite/client` (con un token de HMR caducado: el WebSocket falla) y de
      los módulos CSS (colores rotos). Este script va en línea para que ningún SW pueda servirlo desde
      caché: desregistra el SW, borra sus cachés y recarga una sola vez.
    -->
    {
      esDesarrollo && (
        <script is:inline>
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(async (registros) => {
              if (registros.length === 0) return;
              await Promise.all(registros.map((registro) => registro.unregister()));
              if ('caches' in window) {
                const claves = await caches.keys();
                await Promise.all(claves.map((clave) => caches.delete(clave)));
              }
              if (navigator.serviceWorker.controller) window.location.reload();
            });
          }
        </script>
      )
    }

    <!--
      Registro del Service Worker (RF-009), SÓLO en el build: en desarrollo `sw.js` no existe (lo
      genera `scripts/generar-service-worker.mjs` tras `astro build`) y registrarlo daría un 404.
      Script de módulo procesado por Astro/Vite (no `is:inline`): así `import.meta.env.BASE_URL`
      se sustituye en el build y la ruta del SW respeta el despliegue bajo `/Yapu/`.
    -->
    <script>
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          // `import.meta.env.BASE_URL` puede venir con o sin barra final según el build, así que se
          // normaliza aquí: registrar `/Yapusw.js` (sin barra) daría un 404 silencioso y dejaría la
          // aplicación sin modo offline.
          const base = import.meta.env.BASE_URL;
          const prefijo = base.endsWith('/') ? base : `${base}/`;
          navigator.serviceWorker.register(`${prefijo}sw.js`).catch(() => {
            // Sin Service Worker la aplicación sigue siendo usable; el modo offline se degrada.
          });
        });
      }
    </script>
  </body>
</html>
