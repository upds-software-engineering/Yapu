# ===============================================
# YAPU — CONFIGURACIÓN DE PUERTOS (>= 9500)
# ===============================================

# Aplicación Web & Móvil PWA (Frontend / Astro)
PORT=9500
PUBLIC_APP_PORT=9500
PUBLIC_APP_URL=http://localhost:9500

# Backend / API Microservicio (si aplica)
API_PORT=9501

# Base de Datos SQL: PostgreSQL (Puerto 9532)
POSTGRES_PORT=9532
POSTGRES_HOST=localhost
POSTGRES_DB=yapu_db
POSTGRES_USER=yapu_user
POSTGRES_PASSWORD=yapu_secure_password
DATABASE_URL=postgresql://yapu_user:yapu_secure_password@localhost:9532/yapu_db

# Base de Datos SQL: MySQL (Puerto 9506)
MYSQL_PORT=9506
MYSQL_HOST=localhost
MYSQL_DB=yapu_db
MYSQL_USER=yapu_user
MYSQL_PASSWORD=yapu_secure_password

# Gestor Visual Web SQL: Adminer (Puerto 9580)
ADMINER_PORT=9580
ADMINER_URL=http://localhost:9580

# Memoria Caché: Redis (Puerto 9579)
REDIS_PORT=9579
REDIS_HOST=localhost
